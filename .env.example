# === Gemini AI ===
# API Key de Google AI Studio / Google Cloud para llamadas a Gemini.
# Se puede dejar vacía hasta que se use el módulo de IA.
VITE_GEMINI_API_KEY=""

# === NASA FIRMS API ===
# Obtén tu clave gratuita en https://firms.modaps.eosdis.nasa.gov/api/
# Usada para descargar puntos calientes (hotspots) en tiempo real de MODIS/VIIRS.
VITE_FIRMS_API_KEY=""

# === OpenWeather API ===
# Clave gratuita en https://openweathermap.org/api
# Usada para viento, temperatura y humedad en la ubicación del foco.
VITE_OPENWEATHER_API_KEY=""

# === Sentinel Hub (Copernicus Data Space) ===
# Credenciales OAuth2 para descargar imágenes multiespectrales Sentinel-2.
# Obtén una cuenta gratuita en https://dataspace.copernicus.eu/
VITE_SENTINEL_CLIENT_ID=""
VITE_SENTINEL_CLIENT_SECRET=""

# === EUMETSAT (LSA SAF / Data Store) ===
# Consumer key/secret y API token de https://user.eumetsat.int/
# Usados para SEVIRI y Sentinel-3 SLSTR Fire.
VITE_EUMETSAT_CONSUMER_KEY=""
VITE_EUMETSAT_CONSUMER_SECRET=""
VITE_EUMETSAT_API_TOKEN=""

# === AEMET OpenData ===
# Clave gratuita en https://opendata.aemet.es/
# Usada para riesgo de incendio y datos meteorológicos oficiales por municipio.
VITE_AEMET_API_KEY=""

# === App URL ===
# URL donde se aloja la app. En local: http://localhost:3000
# En producción: https://tu-proyecto.web.app o https://tu-dominio.vercel.app
APP_URL="http://localhost:3000"

# === Firebase Config ===
# Estos valores se obtienen en Firebase Console:
#   1. Ve a https://console.firebase.google.com
#   2. Crea un proyecto (o usa uno existente)
#   3. Ve a Configuración del proyecto > General > Tus aplicaciones
#   4. Añade una app Web (</>) y copia el objeto firebaseConfig
#   5. Si tienes una segunda base de datos Firestore, pon su ID aquí. Si no, déjala vacía.
#   6. El OAuth Client ID se obtiene en Google Cloud > APIs y servicios > Credenciales.

VITE_FIREBASE_API_KEY="TU_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="TU_PROYECTO.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="TU_PROYECTO_ID"
VITE_FIREBASE_STORAGE_BUCKET="TU_PROYECTO.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="TU_SENDER_ID"
VITE_FIREBASE_APP_ID="TU_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Clave VAPID de Cloud Messaging (opcional, para notificaciones push FCM)
# Se obtiene en Firebase Console > Configuración del proyecto > Cloud Messaging > Claves de Web Push
VITE_FIREBASE_VAPID_KEY=""
